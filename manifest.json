{
  "manifest_version": 3,
  "name": "Tema persona 5 WhatsApp",
  "version": "1.0.0",
  "description": "Personaliza el color de burbujas de mensajes en WhatsApp Web en un estilo de los chats de persona 5 royal.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "./scripts/script.js"
      ],
      "css": [
        "./styles/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "permissions": [],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ]
}